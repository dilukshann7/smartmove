ORACLE_USER=SMARTMOVE_DATABASE_APP
ORACLE_PASSWORD=replace_locally
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smartmove

# Required by the website; place real values in website/.env.local.
AUTH_TOKEN_SECRET=generate_32_random_bytes_encoded_as_base64
NOTIFICATIONS_START_AT=set_once_to_an_ISO_timestamp_with_timezone
